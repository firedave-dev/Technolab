# --- Serveur ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Base de données ---
MONGODB_URI=mongodb://127.0.0.1:27017/technolab_ista

# --- JWT (remplacer par des secrets longs et aleatoires en production) ---
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# --- Compte administrateur cree par le seed ---
SEED_ADMIN_EMAIL=admin@technolab-ista.edu
SEED_ADMIN_PASSWORD=Admin@1234

# --- Messagerie ---
# SMTP_HOST vide = les messages sont journalises en console au lieu d'etre envoyes.
# SMTP_PASS attend un MOT DE PASSE D'APPLICATION, jamais le mot de passe du compte.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TechnoLAB-ISTA <no-reply@technolab-ista.net>

# --- Identification legale portee par les recus et attestations ---
ETABLISSEMENT_RAISON_SOCIALE=Technolab ISTA
ETABLISSEMENT_RCCM=
ETABLISSEMENT_NIF=
ETABLISSEMENT_ADRESSE=
