# --- Serveur ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Base de données ---
MONGODB_URI=mongodb://127.0.0.1:27017/technolab_ista

# --- JWT (remplacer par des secrets longs et aleatoires en production) ---
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# --- Compte administrateur cree par le seed ---
SEED_ADMIN_EMAIL=admin@technolab-ista.edu
SEED_ADMIN_PASSWORD=Admin@1234

# --- Messagerie ---
# Envoi par l'API Resend. Le domaine de l'adresse d'expedition doit etre verifie
# chez Resend (SPF + DKIM), sinon le courrier part en indesirable.
#
# Cle vide = MODE DEGRADE : les messages sont journalises, rien ne part sur le
# reseau. C'est le reglage attendu en developpement et pendant les tests.
RESEND_API_KEY=

# Adresse d'expedition, et nom lisible affiche a cote.
# L'adresse peut aussi s'ecrire « Nom <adresse> » : les deux formes sont acceptees.
SMTP_FROM=mails@technolab-ista.org
SMTP_FROM_NAME=TechnoLAB-ISTA

# Ou atterrissent les reponses des familles : l'adresse d'expedition ci-dessus
# n'est pas relevee.
SMTP_REPLY_TO=technolab@technolab-ista.net

# --- Identification legale portee par les recus et attestations ---
ETABLISSEMENT_RAISON_SOCIALE=Technolab ISTA
ETABLISSEMENT_RCCM=RC 1316
ETABLISSEMENT_NIF=685 101 3832
# Portees par le pied des emails. Une ligne vide est simplement omise :
# mieux vaut une mention absente qu'une mention fausse sur un courrier officiel.
ETABLISSEMENT_TELEPHONE=+223 20 29 01 54 / +223 20 29 19 43
ETABLISSEMENT_EMAIL=technolab@technolab-ista.net
ETABLISSEMENT_AGREMENT=N° 0699/98 MESSRS
ETABLISSEMENT_ADRESSE=Sévaré, Mopti, Mali
